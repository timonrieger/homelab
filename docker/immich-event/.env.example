# You can find documentation for all the supported env variables at https://docs.immich.app/install/environment-variables

# Everything stays on the SSD; uploads are staged here only until they are moved to the main instance
UPLOAD_LOCATION=/srv/docker/immich-event/library

# The immich-event system user; no family group, this instance sees nothing but its own data
PUID=2007
PGID=2007

DB_DATA_LOCATION=/srv/docker/immich-event/postgres

TZ=Europe/Zurich

# Connection secret for postgres. Use a different one than the main instance
# Please use only the characters `A-Za-z0-9`, without special characters or spaces
DB_PASSWORD=REPLACE-ME

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
