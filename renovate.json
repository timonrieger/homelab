{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>timonrieger/dotfiles//.github/renovate-base"],
  "packageRules": [
    {
      "description": "update Caddy in both the Dockerfile and compose config",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["caddy"],
      "groupName": "caddy"
    },
    {
      "description": "update both immich-public-proxy images together, they share one config",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["alangrainger/immich-public-proxy", "alangrainger/immich-public-proxy-upload"],
      "groupName": "immich-public-proxy"
    }
  ]
}
