#!/usr/bin/env fish

cd /

echo "["(date "+%Y-%m-%d %H:%M:%S")"] Running restic backup…"
set -x RESTIC_PASSWORD REPLACE-ME
timeout 3h restic -r rclone:storj:beelink-backup backup /srv /home \
  --exclude "/srv/media/**" \
  --exclude "/srv/docker/jellyfin/cache/**" \
  --exclude "/srv/docker/jellyfin/config/log/**" \
  --exclude "/srv/docker/immich/thumbs/**" \
  --exclude "/srv/docker/immich/encoded-video/**" \
  --exclude "/srv/docker/immich/model-cache/**" \
  --exclude "/srv/docker/immich/ml-cache/**" \
  --exclude "/srv/docker/immich/ml-config/**" \
  --exclude "/srv/docker/immich-event/library/thumbs/**" \
  --exclude "/srv/docker/immich-event/library/encoded-video/**" \
  --pack-size=60
set EXIT_CODE $status

echo "["(date "+%Y-%m-%d %H:%M:%S")"] Backup finished with exit code $EXIT_CODE."

# Determine heartbeat status
if test $EXIT_CODE -eq 0
    set STATUS "up"
    set MSG "Backup completed successfully"
else if test $EXIT_CODE -eq 124
    set STATUS "down"
    set MSG "Backup timed out"
else
    set STATUS "down"
    set MSG "Backup failed (code $EXIT_CODE)"
end

echo "["(date "+%Y-%m-%d %H:%M:%S")"] Sending heartbeat to Uptime Kuma…"
set MSG_ENCODED (string escape --style url "$MSG")
curl -m 10 --retry 5 "http://beelink:3001/api/push/<BACKUP_HEARTBEAT_TOKEN>?status=$STATUS&msg=$MSG_ENCODED&ping="
echo "["(date "+%Y-%m-%d %H:%M:%S")"] Heartbeat sent."

# Drop stale locks left behind by an interrupted/timed-out backup.
restic -r rclone:storj:beelink-backup unlock

# Only rotate/prune after a successful backup
if test $EXIT_CODE -eq 0
    echo "["(date "+%Y-%m-%d %H:%M:%S")"] Pruning historical backups…"
    restic -r rclone:storj:beelink-backup forget --keep-daily 7 \
      --keep-weekly 4 --keep-monthly 6 --keep-yearly 2 --prune
    set PRUNE_EXIT_CODE $status
    echo "["(date "+%Y-%m-%d %H:%M:%S")"] Backup pruning finished with exit code $PRUNE_EXIT_CODE."
else
    echo "["(date "+%Y-%m-%d %H:%M:%S")"] Skipping prune because backup did not succeed."
end
