#!/usr/sbin/nft -f
# Docker and Tailscale keep their rules in their own tables, so this file must never `flush ruleset`.

table inet homelab
flush table inet homelab

table inet homelab {
  # Also catches published ports over IPv6: Docker's userland proxy answers those on the host instead of DNATing.
  chain input {
    type filter hook input priority filter; policy drop;
    ct state established,related accept
    ct state invalid drop
    iifname { "lo", "tailscale0", "docker0" } accept
    iifname "br-*" accept
    meta l4proto { icmp, ipv6-icmp } accept
    udp dport { 68, 546 } accept comment "DHCP and DHCPv6 replies"
    udp dport 5353 accept comment "mDNS, so beelink.local resolves"
    udp dport 41641 accept comment "direct Tailscale connections from LAN peers"
    tcp dport 22 accept comment "LAN SSH, the way back in when Tailscale is down"
  }

  # Matching DNAT instead of the LAN interface keeps replies to container and exit-node traffic flowing.
  chain forward {
    type filter hook forward priority filter - 1; policy accept;
    iifname { "tailscale0", "docker0" } accept
    iifname "br-*" accept
    ct status dnat drop
  }
}
